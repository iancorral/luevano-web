---
// Fotos reales de trabajos. Se agregan dejando la imagen en src/assets/images/work/
// (y su descripción en WORK_CAPTIONS). Si la carpeta está vacía, la sección no aparece.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { BUSINESS } from '@/config/business';
import { WORK_CAPTIONS } from '@/data/content';

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/work/*.{jpg,jpeg,png,webp}', {
  eager: true,
});

const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, module]) => {
    const name = path.split('/').pop() ?? '';
    return { src: module.default, alt: WORK_CAPTIONS[name] ?? `Trabajo realizado en ${BUSINESS.name}` };
  });
---

{photos.length > 0 && (
  <section class="section work" aria-labelledby="work-title">
    <div class="container">
      <SectionHeader kicker="Trabajos reales" id="work-title">
        Así queda tu <span class="script">carro</span>
        <p class="lead" slot="lead">
          Fotos de trabajos hechos en el taller. Desliza para ver más.
        </p>
      </SectionHeader>
    </div>
    <ul class="work__track" data-reveal>
      {photos.map((photo) => (
        <li class="work__item">
          <Picture
            src={photo.src}
            alt={photo.alt}
            widths={[360, 640, 960]}
            sizes="(min-width: 980px) 30vw, 80vw"
            formats={['avif', 'webp']}
          />
        </li>
      ))}
    </ul>
    <div class="container work__more" data-reveal>
      <ArrowLink href={BUSINESS.facebook}>Ver más trabajos en Facebook</ArrowLink>
    </div>
  </section>
)}

<style>
  /* Carrusel con el dedo en celular (scroll-snap), rejilla en computadora */
  .work__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 80%;
    gap: 0.75rem;
    margin: 0;
    padding: 0 var(--gutter) 0.5rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
  }

  .work__item {
    scroll-snap-align: start;
  }

  .work__item :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (min-width: 980px) {
    .work__track {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 82.5rem;
      margin-inline: auto;
      overflow: visible;
    }
  }

  .work__more {
    margin-top: 1.75rem;
  }

  .work__more :global(.arrow-link) {
    color: var(--blue);
  }
</style>
