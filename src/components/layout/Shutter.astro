---
// Cortina metálica del taller: se sube al entrar, una vez por visita.
// Solo se muestra si el script del <head> marcó data-intro="pending".
import { Image } from 'astro:assets';
import logo from '@/assets/images/logo.png';
---

<div class="shutter" aria-hidden="true" data-shutter>
  <div class="shutter__center" data-shutter-center>
    <span class="shutter__plate">
      <Image src={logo} alt="" width={280} densities={[1, 2]} loading="eager" />
    </span>
    <p data-shutter-greeting>Taller familiar en la Campesina</p>
  </div>
  <span class="shutter__handle"></span>
</div>

<style>
  .shutter {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    place-items: center;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(0 0 0 / 0.25)),
      repeating-linear-gradient(
        180deg,
        #24335f 0 0.4375rem,
        #34467a 0.4375rem 0.9375rem,
        #1a2650 0.9375rem 1.125rem
      );
    box-shadow: inset 0 -0.875rem 0 var(--blue-night);
  }

  /* Seguro: si el script no corre, la cortina se quita sola */
  :global([data-intro='pending']) .shutter {
    display: grid;
    animation: shutter-failsafe 0s linear 4s forwards;
  }

  @keyframes shutter-failsafe {
    to {
      visibility: hidden;
    }
  }

  .shutter__center {
    text-align: center;
    color: var(--white);
  }

  .shutter__plate {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    border-radius: 3px;
    background: var(--white);
    box-shadow: 0 1.125rem 2.5rem -1.125rem rgb(0 0 0 / 0.7);
  }

  .shutter__plate img {
    width: min(17.5rem, 64vw);
  }

  .shutter p {
    margin: 1.125rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #dde5f7;
  }

  .shutter__handle {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: 7.5rem;
    height: 0.625rem;
    margin-left: -3.75rem;
    border-radius: 0.375rem;
    background: var(--blue-night);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.15);
  }
</style>
