---
// Servicios como acordeón: el detalle se abre justo debajo del servicio que se toca.
// En computadora la pieza 3D vive fija a un lado; en celular se mueve dentro del servicio abierto.
import Button from '@/components/ui/Button.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { SERVICES } from '@/data/services';
import { links } from '@/lib/links';

const [first] = SERVICES;
---

<section class="section" id="servicios">
  <div class="container">
    <SectionHeader kicker="Servicios">
      Empieza por lo que <span class="script">notas</span>
      <p class="lead" slot="lead">
        No necesitas saber de mecánica. Toca lo que le pasa a tu carro y te decimos qué revisamos.
      </p>
    </SectionHeader>

    <div class="explorer" data-explorer>
      <div class="stage" aria-hidden="true" data-reveal>
        <p class="stage__caption" data-stage-caption>
          {first?.stageCaption}
        </p>
        <div class="stage__slot" data-desktop-slot>
          <div class="stage__view" data-stage-view></div>
        </div>
      </div>

      <ul class="services" data-reveal>
        {SERVICES.map((service, i) => (
          <li class="service">
            <h3 class="service__heading">
              <button
                type="button"
                class="service__toggle"
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`service-${service.slug}`}
                data-piece={service.piece}
                data-caption={service.stageCaption}
              >
                <span class="service__name">{service.name}</span>
                <span class="service__symptoms">{service.symptoms}</span>
                <span class="service__arrow" aria-hidden="true">
                  →
                </span>
              </button>
            </h3>
            <div class="service__detail" id={`service-${service.slug}`} hidden={i !== 0}>
              <div class="service__media" aria-hidden="true">
                <p class="stage__caption">{service.stageCaption}</p>
                <div class="stage__slot" data-mobile-slot></div>
              </div>
              <p class="service__summary">{service.summary}</p>
              <div class="service__actions">
                <Button
                  href={links.whatsapp(`Hola, quiero informes de ${service.topic}.`)}
                  variant="whatsapp"
                  icon="whatsapp"
                >
                  Preguntar por {service.topic}
                </Button>
                <ArrowLink href={`/${service.slug}`}>Ver más</ArrowLink>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import type { ServicePiece } from '@/data/services';
  import { mountStageWhenNear } from '@/scripts/scene3d/mount';

  const explorer = document.querySelector<HTMLElement>('[data-explorer]');
  const view = explorer?.querySelector<HTMLElement>('[data-stage-view]');
  const desktopSlot = explorer?.querySelector<HTMLElement>('[data-desktop-slot]');

  if (explorer && view && desktopSlot) {
    const toggles = [...explorer.querySelectorAll<HTMLButtonElement>('.service__toggle')];
    const caption = explorer.querySelector('[data-stage-caption]');
    const desktop = window.matchMedia('(min-width: 980px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current: HTMLButtonElement | undefined = toggles[0];
    let active = (current?.dataset.piece ?? 'alignment') as ServicePiece;

    const detailOf = (toggle: HTMLButtonElement) =>
      document.getElementById(toggle.getAttribute('aria-controls') ?? '');

    // Una sola pieza 3D: se acomoda a un lado (computadora) o dentro del servicio abierto (celular).
    const placeView = () => {
      const target =
        desktop.matches || !current ? desktopSlot : detailOf(current)?.querySelector('[data-mobile-slot]');
      if (target && view.parentElement !== target) target.append(view);
    };

    const open = (toggle: HTMLButtonElement) => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      const before = toggle.getBoundingClientRect().top;

      for (const t of toggles) {
        const expand = t === toggle && !isOpen;
        t.setAttribute('aria-expanded', String(expand));
        const detail = detailOf(t);
        if (detail) detail.hidden = !expand;
      }

      if (!isOpen) {
        current = toggle;
        active = toggle.dataset.piece as ServicePiece;
        if (caption) caption.textContent = toggle.dataset.caption ?? '';
      }
      placeView();

      if (desktop.matches) return;
      // Al cerrarse el servicio de arriba, la lista se recorre: se compensa para que no "salte".
      window.scrollBy({ top: toggle.getBoundingClientRect().top - before, behavior: 'instant' });
      const detail = detailOf(toggle);
      if (!isOpen && detail && detail.getBoundingClientRect().bottom > window.innerHeight * 0.85) {
        toggle.scrollIntoView({ block: 'start', behavior: reducedMotion ? 'instant' : 'smooth' });
      }
    };

    toggles.forEach((toggle) => toggle.addEventListener('click', () => open(toggle)));
    desktop.addEventListener('change', placeView);
    placeView();
    mountStageWhenNear(view, () => active);
  }
</script>

<style>
  .explorer {
    display: grid;
  }

  @media (min-width: 980px) {
    .explorer {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 3.75rem;
      align-items: start;
    }
  }

  /* Escenario fijo a un lado, solo en computadora */
  .stage {
    display: none;
    background: radial-gradient(90% 80% at 50% 45%, #1c3170, var(--blue-night) 75%);
    color: var(--white);
  }

  @media (min-width: 980px) {
    .stage:has([data-stage='unavailable']) {
      display: none;
    }

    .stage {
      position: sticky;
      top: 6.5rem;
      order: 2;
      display: grid;
      grid-template-rows: auto 1fr;
      height: min(40rem, calc(100vh - 8.5rem));
    }
  }

  .stage__caption {
    margin: 0;
    padding: 1.125rem 1.375rem 0;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sky);
  }

  .stage__slot {
    position: relative;
    min-height: 15rem;
  }

  .stage__view {
    position: absolute;
    inset: 0;
  }

  .stage__view :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* El margen negativo alinea el texto con el título de la sección;
     el fondo del servicio abierto sale un poco hacia los lados. */
  .services {
    --service-pad: clamp(1rem, 2vw, 1.5rem);
    margin: 0 calc(-1 * var(--service-pad));
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  /* Todos con el mismo margen; el abierto se marca con fondo blanco y la guía azul a la izquierda */
  .service {
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }

  .service:has([aria-expanded='true']) {
    background: var(--white);
    box-shadow:
      inset 0.1875rem 0 0 var(--blue-bright),
      0 1.25rem 2.5rem -2rem rgb(14 20 38 / 0.35);
  }

  .service__heading {
    margin: 0;
    font: inherit;
  }

  .service__toggle {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    align-items: center;
    width: 100%;
    padding: 1.375rem var(--service-pad);
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .service__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #6b7489;
    transition: color 0.25s;
  }

  .service__symptoms {
    grid-column: 1;
    color: var(--gray);
    font-size: 1rem;
  }

  .service__arrow {
    display: grid;
    grid-row: 1 / span 2;
    grid-column: 2;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line);
    color: var(--gray);
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.3s var(--ease-out);
  }

  .service__toggle:hover .service__name {
    color: var(--ink);
  }

  .service__toggle[aria-expanded='true'] .service__name {
    color: var(--blue);
  }

  .service__toggle[aria-expanded='true'] .service__arrow {
    background: var(--blue);
    color: var(--white);
    box-shadow: none;
    transform: rotate(90deg);
  }

  .service__detail {
    padding: 0 var(--service-pad) 1.625rem;
    animation: detail-in 0.35s var(--ease-out);
  }

  @keyframes detail-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service__detail {
      animation: none;
    }
  }

  /* Pieza 3D dentro del servicio abierto, solo en celular */
  .service__media {
    margin: 0 0 1.125rem;
    background: radial-gradient(90% 80% at 50% 45%, #1c3170, var(--blue-night) 75%);
  }

  .service__media:has(.stage__view[data-stage='unavailable']) {
    display: none;
  }

  @media (min-width: 980px) {
    .service__media {
      display: none;
    }
  }

  .service__summary {
    max-width: 48ch;
    margin: 0 0 1.125rem;
    color: var(--gray);
  }

  .service__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem 1.625rem;
  }

  .service__actions :global(.arrow-link) {
    color: var(--blue);
  }
</style>
