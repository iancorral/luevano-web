---
import { HIGHLIGHTS } from '@/data/content';
---

<section class="highlights" aria-label="Cómo trabajamos">
  <div class="highlights__row">
    {HIGHLIGHTS.map((item) => (
      <div class="highlights__item" data-reveal>
        <b>{item.title}</b>
        <span>{item.detail}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .highlights {
    background: var(--blue);
    color: var(--white);
  }

  .highlights__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .highlights__item {
    padding: 1.375rem 1.125rem;
    border-left: 1px solid rgb(255 255 255 / 0.16);
  }

  .highlights__item:nth-child(odd) {
    border-left: 0;
  }

  .highlights b {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    line-height: 1.1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .highlights span {
    color: var(--muted-on-dark);
    font-size: 0.9375rem;
  }

  @media (min-width: 900px) {
    .highlights__row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .highlights__item:nth-child(odd) {
      border-left: 1px solid rgb(255 255 255 / 0.16);
    }

    .highlights__item:first-child {
      border-left: 0;
    }
  }
</style>
