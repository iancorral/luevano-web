---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'whatsapp' | 'blue' | 'white' | 'outline';
  icon?: 'whatsapp' | 'pin' | 'phone';
  size?: 'md' | 'sm';
}

const { href, variant = 'blue', icon, size = 'md', class: className, ...rest } = Astro.props;
const isExternal = /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={['button', `button--${variant}`, `button--${size}`, className]}
  {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}
  {...rest}
>
  {icon && <Icon name={icon} />}
  <span>
    <slot />
  </span>
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 3.625rem;
    padding: 0 1.5rem;
    border: 0;
    border-radius: 2px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s,
      transform 0.15s;
  }

  /* En celular todos los botones miden lo mismo: a todo lo ancho */
  @media (max-width: 759px) {
    .button--md {
      width: 100%;
    }
  }

  .button :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
    flex: none;
  }

  .button:active {
    transform: translateY(1px);
  }

  .button--sm {
    min-height: 2.875rem;
    padding: 0 1.1rem;
    font-size: 0.95rem;
  }

  .button--whatsapp {
    background: var(--whatsapp);
    color: var(--white);
  }

  .button--whatsapp:hover {
    background: var(--whatsapp-hover);
  }

  .button--blue {
    background: var(--blue);
    color: var(--white);
  }

  .button--blue:hover {
    background: var(--blue-dark);
  }

  .button--white {
    background: var(--white);
    color: var(--blue-dark);
  }

  .button--white:hover {
    background: var(--sky);
  }

  .button--outline {
    background: transparent;
    color: currentColor;
    box-shadow: inset 0 0 0 1.5px currentColor;
  }

  .button--outline:hover {
    background: rgb(21 51 124 / 0.06);
  }
</style>
