---
// Acción secundaria. En computadora: texto con flecha. En celular: botón con contorno
// a todo lo ancho, para que se note que se puede tocar.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
}

const { href, class: className, ...rest } = Astro.props;
const isExternal = /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={['arrow-link', className]}
  {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}
  {...rest}
>
  <span>
    <slot />
  </span>
  <svg class="arrow-link__icon" viewBox="0 0 34 12" aria-hidden="true">
    <path d="M0 6h32M27 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"></path>
  </svg>
</a>

<style>
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .arrow-link__icon {
    width: 2.125rem;
    height: 0.75rem;
    flex: none;
    transition: transform 0.3s var(--ease-out);
  }

  .arrow-link:hover .arrow-link__icon {
    transform: translateX(0.375rem);
  }

  @media (max-width: 759px) {
    .arrow-link {
      justify-content: space-between;
      width: 100%;
      min-height: 3.5rem;
      padding: 0 1.25rem;
      border-radius: 2px;
      box-shadow: inset 0 0 0 1.5px currentColor;
      font-size: 1rem;
    }
  }
</style>
