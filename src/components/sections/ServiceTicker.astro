---
// Franja en movimiento constante, como la lona de un taller. Ver scripts/motion/ticker.ts
import { TICKER_ITEMS } from '@/data/content';
---

<div class="ticker" data-ticker>
  <div class="ticker__track" data-ticker-track>
    {[0, 1].map((copy) => (
      <ul class="ticker__group" aria-hidden={copy === 1 ? 'true' : undefined}>
        {TICKER_ITEMS.map((item, i) => (
          <li class:list={['ticker__item', { 'ticker__item--outline': i % 2 === 1 }]}>{item}</li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    padding-block: clamp(1.125rem, 2.6vw, 1.875rem);
    background: var(--blue-night);
    border-block: 1px solid rgb(255 255 255 / 0.08);
    color: var(--white);
  }

  .ticker__track {
    display: flex;
    width: max-content;
  }

  .ticker__group {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ticker__item {
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 4.2rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .ticker__item--outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--sky);
  }

  /* Separador: un rin visto de frente */
  .ticker__item::after {
    content: '';
    width: 0.36em;
    height: 0.36em;
    margin-inline: 0.55em;
    border: 0.07em solid var(--blue-bright);
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 0.08em var(--blue-night),
      inset 0 0 0 0.2em var(--blue-bright);
  }
</style>
